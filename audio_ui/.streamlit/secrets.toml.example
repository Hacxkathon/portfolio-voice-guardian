# Copia este fichero como .streamlit/secrets.toml (NO lo subas a GitHub)
ELEVENLABS_API_KEY = "sk_..."
# Ruta a la base de datos (vacío = se usa ../db/guardian.db si existe; si no, datos de demostración)
PVG_DB_PATH = ""
# Modelo de voz: "eleven_multilingual_v2" (estable) o "eleven_v3" (más expresivo)
ELEVEN_MODEL = "eleven_multilingual_v2"
# Voces (voice_id copiados de ElevenLabs > My Voices)
ELEVEN_VOICE_CERCANA = ""
ELEVEN_VOICE_PROFESIONAL = ""
